  "components": {
    "securitySchemes": {
      "bearerAuth": {"type": "http", "scheme": "bearer", "bearerFormat": "JWT"}
    },
    "parameters": {
      "IdParam": {"name": "id", "in": "path", "required": true, "schema": {"type": "string", "format": "uuid"}},
      "PageParam": {"name": "page", "in": "query", "schema": {"type": "integer", "default": 1}},
      "PerPageParam": {"name": "per_page", "in": "query", "schema": {"type": "integer", "default": 20, "maximum": 100}}
    },
    "schemas": {
      "TokenResponse": {"type": "object", "properties": {"data": {"type": "object", "properties": {"token": {"type": "string"}, "refresh_token": {"type": "string"}, "expires_at": {"type": "string", "format": "date-time"}}}}},
      "CompanyInput": {"type": "object", "required": ["name", "code"], "properties": {"name": {"type": "string"}, "code": {"type": "string"}, "address": {"type": "string"}, "phone": {"type": "string"}, "email": {"type": "string", "format": "email"}}},
      "OfficeInput": {"type": "object", "required": ["name", "code", "type"], "properties": {"company_id": {"type": "string", "format": "uuid"}, "name": {"type": "string"}, "code": {"type": "string"}, "type": {"type": "string", "enum": ["headquarters", "branch", "representative"]}}},
      "UserInput": {"type": "object", "required": ["email", "name", "password"], "properties": {"email": {"type": "string", "format": "email"}, "name": {"type": "string"}, "password": {"type": "string"}, "employee_id": {"type": "string"}, "office_id": {"type": "string", "format": "uuid"}, "department_id": {"type": "string", "format": "uuid"}}},
      "DocumentTypeInput": {"type": "object", "required": ["name", "code"], "properties": {"name": {"type": "string"}, "code": {"type": "string"}, "description": {"type": "string"}, "prefix": {"type": "string"}}},
      "CategoryInput": {"type": "object", "required": ["name", "code"], "properties": {"name": {"type": "string"}, "code": {"type": "string"}, "description": {"type": "string"}, "parent_id": {"type": "string", "format": "uuid"}}},
      "TemplateInput": {"type": "object", "required": ["document_type_id", "name", "code"], "properties": {"document_type_id": {"type": "string", "format": "uuid"}, "category_id": {"type": "string", "format": "uuid"}, "name": {"type": "string"}, "code": {"type": "string"}, "description": {"type": "string"}}},
      "TemplateTagInput": {"type": "object", "required": ["tag_name", "tag_type"], "properties": {"tag_name": {"type": "string"}, "tag_type": {"type": "string", "enum": ["system", "user_input", "calculated"]}, "default_value": {"type": "string"}, "is_required": {"type": "boolean"}}},
      "NumberingInput": {"type": "object", "required": ["document_type_id", "format_pattern"], "properties": {"document_type_id": {"type": "string", "format": "uuid"}, "format_pattern": {"type": "string"}, "reset_period": {"type": "string", "enum": ["yearly", "monthly", "never"]}}},
      "DocumentInput": {"type": "object", "required": ["template_id", "title"], "properties": {"template_id": {"type": "string", "format": "uuid"}, "title": {"type": "string"}, "description": {"type": "string"}, "priority": {"type": "string", "enum": ["low", "normal", "high", "urgent"]}, "confidentiality": {"type": "string", "enum": ["public", "internal", "confidential", "secret"]}}},
      "CommentInput": {"type": "object", "required": ["content"], "properties": {"content": {"type": "string"}, "comment_type": {"type": "string", "enum": ["general", "review", "annotation"]}, "parent_id": {"type": "string", "format": "uuid"}, "version_number": {"type": "integer"}, "page_number": {"type": "integer"}, "is_internal": {"type": "boolean"}}},
      "WorkflowInput": {"type": "object", "required": ["document_type_id", "name"], "properties": {"document_type_id": {"type": "string", "format": "uuid"}, "category_id": {"type": "string", "format": "uuid"}, "name": {"type": "string"}, "description": {"type": "string"}, "is_active": {"type": "boolean"}}},
      "WorkflowStepInput": {"type": "object", "required": ["step_order", "name", "step_type", "assignee_type"], "properties": {"step_order": {"type": "integer"}, "name": {"type": "string"}, "step_type": {"type": "string", "enum": ["review", "approve", "sign"]}, "assignee_type": {"type": "string", "enum": ["user", "role", "position", "department_head"]}, "can_edit": {"type": "boolean"}, "can_comment": {"type": "boolean"}, "can_delegate": {"type": "boolean"}}},
      "DistributionInput": {"type": "object", "required": ["distribution_type", "recipient_type"], "properties": {"distribution_type": {"type": "string", "enum": ["controlled", "uncontrolled", "electronic"]}, "recipient_type": {"type": "string", "enum": ["user", "department", "external"]}, "recipient_id": {"type": "string", "format": "uuid"}, "recipient_name": {"type": "string"}, "notes": {"type": "string"}}},
      "SettingInput": {"type": "object", "required": ["key", "value"], "properties": {"key": {"type": "string"}, "value": {"type": "string"}, "description": {"type": "string"}}}
    }
  }
